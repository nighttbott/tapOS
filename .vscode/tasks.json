{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build OS",
            "command": "make",
            "args": [
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "process",
            "label": "Build Inserter",
            "command": "make",
            "args": [
                "inserter"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "type": "process",
            "label": "Insert Shell",
            "command": "make",
            "args": [
                "insert-shell"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc"
        },
        {
            "type": "shell",
            "label": "Launch QEMU",
            "command": "echo Starting QEMU; exec qemu-system-i386 -m 128M -gdb tcp:127.0.0.1:1234 -S -pidfile .tapOS-debug.pid -drive file=storage.bin,format=raw,if=ide,index=0,media=disk -cdrom OS2025.iso -boot order=d",
            "isBackground": true,
            "dependsOn": [
                "Build OS",
                "Insert Shell"
            ],
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}/bin"
            },
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": "^(QEMU_TASK_ERROR): (.*)$",
                        "file": 1,
                        "kind": "file",
                        "message": 2
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Starting QEMU$",
                    "endsPattern": "^Starting QEMU$"
                }
            }
        },
        {
            "type": "shell",
            "label": "Exit QEMU",
            "command": "if read -r pid < .tapOS-debug.pid 2>/dev/null; then case \"$pid\" in \"\"|*[!0-9]*) exit 1;; esac; if [ \"$(readlink \"/proc/$pid/cwd\")\" = \"$PWD\" ] && tr \"\\000\" \"\\n\" < \"/proc/$pid/cmdline\" | grep -Fxq .tapOS-debug.pid; then kill -TERM \"$pid\"; fi; fi",
            "options": {
                "cwd": "${workspaceFolder}/bin"
            }
        }
    ]
}
